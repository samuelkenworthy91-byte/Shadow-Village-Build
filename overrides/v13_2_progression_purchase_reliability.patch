+ * choices visible at the moment of unlock remain stable until one is chosen.
+ */
+export function freezeTechniqueRows(n: Ninja, techs: VillageTechId[] = []): void {
+  const target = Math.min(10, tiersUnlocked(n.level));
+  const frozen = (n.techniqueRows ?? []).map((row) => [...row]);
+  while (frozen.length < target) {
+    const tree = generateTechniqueTree(n, techs, frozen);
+    const next = tree[frozen.length] ?? [];
+    if (!next.length) break;
+    frozen.push(next.map((p) => p.id));
+  }
+  n.techniqueRows = frozen;
