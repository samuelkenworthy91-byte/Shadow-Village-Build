+import type { JutsuDef, JutsuPassive } from './jutsu';
+import type { Unit } from './types';
+import { jutsuAttackStat, jutsuStatusPreview, isDamageOverTime } from './statusDamage';
+
+const clamp = (n: number, low: number, high: number) => Math.max(low, Math.min(high, n));
+const number = (n: number) => Number(n.toFixed(2)).toString();
+const percent = (n: number) => `${number(n * 100)}%`;
+const rounds = (n: number) => `${n} round${n === 1 ? '' : 's'}`;
+const targets = { foe: 'one enemy', all_foes: 'all enemies', ally: 'one ally (including yourself)', all_allies: 'all living allies (including yourself)', self: 'yourself' };
+const stats = { atk: 'ATK (Attack; mainly Taijutsu)', nin: 'NIN (Ninjutsu)', gen: 'GEN (Genjutsu)', ken: 'KEN (Kenjutsu)', tac: 'TAC (Battlefield Tactics)', doj: 'DŌJ (Dōjutsu)', med: 'MED (Medical)', spd: 'SPD (combat Speed)', ste: 'STE (Stealth)' };
+
+const passiveLabels: Record<keyof JutsuPassive, string> = {
+  hp: 'Max HP', cp: 'Max chakra', atk: 'Attack', def: 'Defence', spd: 'Speed', jutsuPower: 'Jutsu power',
+  crit: 'Critical-hit chance', dodge: 'Dodge chance', counter: 'Counter damage returned', burnAmp: 'Burn damage',
+  burnRounds: 'Burn duration', guardAmp: 'Barrier strength', regenAmp: 'Regeneration healing',
+  pierceBonus: 'Piercing defence bypass', stunBonus: 'Jutsu stun chance', chakraCost: 'Chakra cost',
+  shredBonus: 'Armour shred', braceAmp: 'Brace strength', tauntBonus: 'Taunt strength',
+  retaliationBonus: 'Retaliation damage fraction', extraTurnBonus: 'Bonus-turn chance',
+};
+const additive = new Set<keyof JutsuPassive>(['crit', 'dodge', 'counter', 'pierceBonus', 'stunBonus', 'shredBonus', 'tauntBonus', 'retaliationBonus', 'extraTurnBonus']);
+
+/** Reads the final technique data and current combat stats; never changes a save. */
+export function describeJutsu(u: Unit, j: JutsuDef, cost = j.chakra): { scaling: string; lines: string[] } {
+  if (j.passive) {
+    const lines = ['Permanent while learned. No chakra cost and no equipped-jutsu slot.'];
+    for (const [key, value] of Object.entries(j.passive) as [keyof JutsuPassive, number][]) {
+      if (key === 'burnRounds') lines.push(`${passiveLabels[key]}: +${rounds(value)}.`);
+      else if (additive.has(key)) lines.push(`${passiveLabels[key]}: +${number(value * 100)} percentage points.`);
+      else lines.push(`${passiveLabels[key]}: ${value >= 1 ? '+' : '−'}${percent(Math.abs(value - 1))}.`);
+    }
+    return { scaling: 'Passive mastery · fixed bonuses', lines };
+  }
+  const hostile = j.target === 'foe' || j.target === 'all_foes';
+  const damaging = hostile && (j.power > 0 || isDamageOverTime(j.effect));
+  const healing = !hostile && (j.power > 0 || j.effect === 'regen');
+  const stat = j.stat ?? 'nin';
+  const scaling = damaging ? `Scales with ${stats[stat]} · current ${number(jutsuAttackStat(u, j))}`
