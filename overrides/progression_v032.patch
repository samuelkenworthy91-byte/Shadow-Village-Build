+export function perkMechanics(p: Perk): string {
+  const out: string[] = [];
+  const f = p.fx;
+  if (f) {
+    if (f.atk != null && f.atk !== 1) out.push(`Battle ATK ${pctDelta(f.atk) >= 0 ? "+" : ""}${pctDelta(f.atk)}%`);
+    if (f.def != null && f.def !== 1) out.push(`Battle DEF ${pctDelta(f.def) >= 0 ? "+" : ""}${pctDelta(f.def)}%`);
+    if (f.hp != null && f.hp !== 1) out.push(`Max HP ${pctDelta(f.hp) >= 0 ? "+" : ""}${pctDelta(f.hp)}%`);
+    if (f.cp != null && f.cp !== 1) out.push(`Max chakra ${pctDelta(f.cp) >= 0 ? "+" : ""}${pctDelta(f.cp)}%`);
+    if (f.crit) out.push(`Crit chance +${points(f.crit)}pp`);
+    if (f.critMult) out.push(`Critical damage +${points(f.critMult)}pp`);
+    if (f.dodge) out.push(`Dodge chance +${points(f.dodge)}pp`);
+    if (f.lifesteal) out.push(`Heal for ${points(f.lifesteal)}% of damage dealt`);
+    if (f.counter) out.push(`Counter for ${points(f.counter)}% of damage received`);
+    if (f.regen) out.push(`+${f.regen} HP and +${f.regen} chakra each new round`);
+    if (f.firstStrike) out.push("Acts first in the opening round; +12 initiative on later rounds");
+    if (f.jutsu != null && f.jutsu !== 1) out.push(`Jutsu damage ${pctDelta(f.jutsu) >= 0 ? "+" : ""}${pctDelta(f.jutsu)}%`);
+  }
+
+  const v = p.village;
+  if (v) {
+    if (v.missionBonus) out.push(`Mission success +${points(v.missionBonus)}pp`);
+    if (v.fatigue != null && v.fatigue !== 1) out.push(`Mission fatigue ${pctDelta(v.fatigue)}%`);
+    if (v.xp != null && v.xp !== 1) out.push(`XP ${pctDelta(v.xp) >= 0 ? "+" : ""}${pctDelta(v.xp)}%`);
+  }
+
+  // Effects implemented by explicit perk-id checks rather than the generic fx object.
+  if (p.id === "minddagger") out.push("Genjutsu automatically lands and stuns the target for 2 rounds");
+  if (p.id === "fieldmedic") out.push("Heal action +40%; on failed missions, other squadmates recover 1 day sooner");
+  if (p.id === "willoffire") out.push("All allies deal +12% battle damage while this ninja is deployed");
+  if (p.id === "commandnet") out.push("All allies deal +7% battle damage while this ninja is deployed");
+
+  if (p.tech) {
+    const t = p.tech;
+    if (p.id === "mysticrevive") {
+      out.push("Special: revive one downed ally at 60% max HP; if nobody is down, heal all living allies for MED × 1.5");
+    } else {
+      const target = p.id === "shadowclone" || p.id === "lg_summon" ? "all enemies" : p.id === "assassinate" ? "the lowest-HP enemy" : "one enemy";
+      out.push(`Special ${t.name}: ${t.hits} hit${t.hits === 1 ? "" : "s"} at ${t.power.toFixed(2)}× ${SKILL_LABEL[t.stat]} scaling; targets ${target}`);
+      if (p.id === "gatekeeper" || p.id === "lg_silentmist" || p.id === "kekkei_magma") out.push("Special ignores Guard damage reduction");
+      if (p.id === "nightmare") out.push("Special stuns for 2 rounds");
+      if (p.id === "lg_beastcloak") out.push("Special damage gains up to +110% as HP is lost");
+      if (p.id === "lg_summon") out.push("Special also heals every living ally for MED × 1.2 + 6 HP");
+    }
+  }
+
+  return out.length ? out.join(" · ") : "No numeric combat or mission modifier; see the technique rule above.";
