+export function beginRaidBattle(s: GameState, ids: number[]): boolean {
+  if (s.phase !== "raid_select") return false;
+  const unique = [...new Set(ids)].slice(0, 4);
+  const defenders = unique.map((id) => s.ninjas.find((n) => n.id === id)).filter((n): n is Ninja => !!n && n.status === "ready");
+  if (defenders.length === 0) return false;
+  s.battle = startBattle(s, defenders);
+  s.phase = "battle";
+  return true;
+}
