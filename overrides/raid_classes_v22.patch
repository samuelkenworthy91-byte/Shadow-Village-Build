+export function raidClassPool(s: Pick<GameState, "day" | "raids">): string[] {
+  const pool = ["rogue_genin", "bandit_scout", "war_monk", "ash_bowman"];
+  if (s.day >= 5 || s.raids >= 1) pool.push("oni_brawler", "mist_assassin");
+  if (s.day >= 9 || s.raids >= 2) pool.push("clan_guard", "torch_saboteur");
+  if (s.day >= 13 || s.raids >= 3) pool.push("clan_captain");
+  if (s.day >= 18 || s.raids >= 5) pool.push("dread_veteran");
+  return pool;
+}
