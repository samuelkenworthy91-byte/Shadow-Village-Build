+            <p className="text-[11px] font-bold text-paper/70">{sel.length}/4 defenders · <span className={tone}>{sel.length ? `${Math.round(ratio * 100)}% of estimated raid power` : "choose your team"}</span></p>
+          </div>
+          <button
+            disabled={sel.length === 0}
+            onClick={() => onDefend(sel)}
