+      <div className="modal-pop flex max-h-[94dvh] w-full max-w-xl flex-col rounded-t-2xl bg-[#151728]/98 shadow-2xl ring-1 ring-[#e2452f]/35 sm:rounded-2xl">
+        <div className="border-b border-white/8 p-3">
