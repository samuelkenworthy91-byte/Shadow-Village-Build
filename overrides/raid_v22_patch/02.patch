+  const [sel, setSel] = useState<number[]>([]);
+  const forecast = raidForecast(s);
+
+  const home = useMemo(
+    () => s.ninjas
+      .filter((n) => n.status === "ready")
+      .map((n) => ({ n, power: unitCombatPower(unitFromNinja(n)) }))
+      .sort((a, b) => b.power - a.power),
+    [s.ninjas]
+  );
+
+  const selectedPower = sel
+    .map((id) => home.find((x) => x.n.id === id)?.power ?? 0)
+    .reduce((a, b) => a + b, 0);
+  const ratio = forecast.enemyPower > 0 ? selectedPower / forecast.enemyPower : 0;
+  const tone = sel.length === 0 ? "text-paper/35" : ratio >= 1.15 ? "text-jade" : ratio >= 0.9 ? "text-gold" : "text-[#ff7a5c]";
+
+  const toggle = (id: number) => {
+    setSel((cur) => {
+      if (cur.includes(id)) return cur.filter((x) => x !== id);
+      if (cur.length >= 4) return cur;
+      return [...cur, id];
+    });
+  };
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Enter" && sel.length > 0) {
+        e.preventDefault();
+        onDefend(sel);
+      } else if (e.key >= "1" && e.key <= "9") {
+        const candidate = home[Number(e.key) - 1];
+        if (candidate) toggle(candidate.n.id);
+      }
+    };
+    window.addEventListener("keydown", onKey, true);
+    return () => window.removeEventListener("keydown", onKey, true);
+  });
+
+  return (
