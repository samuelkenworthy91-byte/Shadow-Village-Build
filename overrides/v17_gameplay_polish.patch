@@ -0,0 +1,169 @@
+import type { EquipmentArt, EquipmentItem } from "../game/equipment";
+import { RARITY_META } from "../game/equipment";
+
+/**
+ * Small illustrated picture for a piece of equipment.
+ *
+ * Each drawing matches the item's written in-game appearance: the shape comes
+ * from the base type (headband, kunai, vest, ...) and the main colour comes
+ * from the item prefix, so a "Crimson Vest" is a red vest and an "Obsidian
+ * Kunai" is a black blade. The rarity colour is used for the metal fittings
+ * and the surrounding frame.
+ */
+export default function EquipmentArtwork({
+  item,
+  size = 36,
+  className,
+}: {
+  item: EquipmentItem;
+  size?: number;
+  className?: string;
+}) {
+  const r = RARITY_META[item.rarity];
+  const tint = item.tint ?? "#8a9099";
+  const dark = `color-mix(in srgb, ${tint} 55%, #05060a)`;
+  const light = `color-mix(in srgb, ${tint} 70%, #ffffff)`;
+
+  return (
+    <span
+      className={className}
+      style={{
+        display: "grid",
+        placeItems: "center",
+        width: size,
+        height: size,
+        borderRadius: Math.round(size * 0.26),
+        background: `radial-gradient(circle at 32% 24%, ${r.color}22, ${r.dark} 78%)`,
+        boxShadow: `inset 0 0 0 1px ${r.border}`,
+        flexShrink: 0,
+      }}
+      role="img"
+      aria-label={`${item.name} illustration`}
+      title={item.appearance}
+    >
+      <svg width={Math.round(size * 0.78)} height={Math.round(size * 0.78)} viewBox="0 0 32 32">
+        <Art art={item.art ?? "talisman"} tint={tint} dark={dark} light={light} metal={r.color} />
+      </svg>
+    </span>
+  );
+}
+
+function Art({ art, tint, dark, light, metal }: { art: EquipmentArt; tint: string; dark: string; light: string; metal: string }) {
+  switch (art) {
+    case "headband":
+      // Long cloth wrap centred on a reinforced metal plate.
+      return (
+        <g>
+          <path d="M2 13h28v6H2z" fill={tint} />
+          <path d="M2 17h28v2H2z" fill={dark} />
+          <path d="M4 19l-2 8 6-4z" fill={tint} />
+          <path d="M28 19l2 8-6-4z" fill={dark} />
+          <rect x="10" y="11" width="12" height="10" rx="2" fill={metal} />
+          <rect x="11.5" y="12.5" width="9" height="7" rx="1.5" fill={dark} opacity="0.35" />
+          <path d="M16 14.2l1.6 3.2-1.6-.9-1.6.9z" fill={light} />
+        </g>
+      );
+    case "kunai":
+      // Leaf-shaped throwing blade, wrapped grip, ring pommel.
+      return (
+        <g>
+          <path d="M16 1l5 9-5 5-5-5z" fill={metal} />
+          <path d="M16 1l5 9-5 5z" fill={light} opacity="0.55" />
+          <rect x="14" y="15" width="4" height="10" rx="1" fill={tint} />
+          <path d="M14 17h4M14 19.5h4M14 22h4" stroke={dark} strokeWidth="1" />
+          <circle cx="16" cy="27.5" r="3.2" fill="none" stroke={metal} strokeWidth="1.8" />
+        </g>
+      );
+    case "vest":
+      // Sleeveless shinobi vest with high shoulders and utility pockets.
+      return (
+        <g>
+          <path d="M8 5l8 4 8-4 4 4v18H4V9z" fill={tint} />
+          <path d="M16 9v18" stroke={dark} strokeWidth="1.4" />
+          <path d="M8 5l8 4-4 4-6-6z" fill={light} opacity="0.4" />
+          <rect x="5.5" y="17" width="6" height="5" rx="1" fill={dark} />
+          <rect x="20.5" y="17" width="6" height="5" rx="1" fill={dark} />
+        </g>
+      );
+    case "scroll":
+      // Tightly rolled field scroll with stiff end caps and cord.
+      return (
+        <g>
+          <rect x="4" y="11" width="24" height="10" rx="2" fill={tint} />
+          <rect x="2.5" y="9" width="4" height="14" rx="1.6" fill={metal} />
+          <rect x="25.5" y="9" width="4" height="14" rx="1.6" fill={metal} />
+          <path d="M9 14h14M9 17h10" stroke={dark} strokeWidth="1.2" />
+          <path d="M16 21v6" stroke={metal} strokeWidth="1.6" />
+          <circle cx="16" cy="28" r="1.8" fill={light} />
+        </g>
+      );
+    case "gloves":
+      // Combat gloves: reinforced knuckles, wrapped wrists.
+      return (
+        <g>
+          <path d="M7 10h13a4 4 0 014 4v6a4 4 0 01-4 4H7z" fill={tint} />
+          <rect x="4" y="19" width="6" height="7" rx="1.5" fill={dark} />
+          <circle cx="14" cy="14" r="1.7" fill={metal} />
+          <circle cx="19" cy="14" r="1.7" fill={metal} />
+          <circle cx="23.5" cy="15" r="1.5" fill={metal} />
+          <path d="M8 22h13" stroke={light} strokeWidth="1.1" opacity="0.6" />
+        </g>
+      );
+    case "tabi":
+      // Split-toe shinobi boots with layered soles.
+      return (
+        <g>
+          <path d="M9 4h8v13l7 6v4H9z" fill={tint} />
+          <path d="M9 27h15v3H9z" fill={dark} />
+          <path d="M17 17l7 6h-7z" fill={light} opacity="0.4" />
+          <path d="M9 9h8M9 13h8" stroke={dark} strokeWidth="1.1" />
+          <path d="M20.5 22.5v4" stroke={metal} strokeWidth="1.2" />
+        </g>
+      );
+    case "mask":
+      // Close-fitting half mask with ventilation cuts and rear ties.
+      return (
+        <g>
+          <path d="M6 10h20v7c0 5-4.5 9-10 9S6 22 6 17z" fill={tint} />
+          <path d="M6 10h20v4H6z" fill={dark} />
+          <path d="M11 18h10M12 21h8" stroke={dark} strokeWidth="1.3" />
+          <path d="M6 12L1 9v5zM26 12l5-3v5z" fill={metal} />
+        </g>
+      );
+    case "talisman":
+      // Layered paper-and-wood charm on braided cord with a seal plate.
+      return (
+        <g>
+          <path d="M16 2v6" stroke={metal} strokeWidth="1.4" />
+          <circle cx="16" cy="3" r="2" fill="none" stroke={metal} strokeWidth="1.3" />
+          <path d="M9 8h14v16l-7 6-7-6z" fill={tint} />
+          <path d="M9 8h14v3H9z" fill={dark} />
+          <rect x="12.5" y="13" width="7" height="7" rx="1" fill={metal} />
+          <path d="M14 15.5h4M14 18h4" stroke={dark} strokeWidth="1" />
+        </g>
+      );
+    case "sash":
+      // Broad folded waist sash with a reinforced knot.
+      return (
+        <g>
+          <path d="M1 11h30v10H1z" fill={tint} />
+          <path d="M1 15h30v2H1z" fill={dark} opacity="0.7" />
+          <path d="M12 9h8v14h-8z" fill={dark} />
+          <path d="M13 23l-3 7 6-3zM19 23l3 7-6-3z" fill={tint} />
+          <circle cx="16" cy="16" r="2.2" fill={metal} />
+        </g>
+      );
+    case "ring":
+      // Heavy shinobi ring with a flat engraved outer face.
+      return (
+        <g>
+          <circle cx="16" cy="18" r="10" fill="none" stroke={metal} strokeWidth="4" />
+          <circle cx="16" cy="18" r="10" fill="none" stroke={dark} strokeWidth="1" />
+          <path d="M10 9h12v6H10z" fill={tint} />
+          <rect x="12" y="10.2" width="8" height="3.6" rx="1" fill={light} opacity="0.65" />
+        </g>
+      );
+    default:
+      return <circle cx="16" cy="16" r="10" fill={tint} />;
+  }
+}
