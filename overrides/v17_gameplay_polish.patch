+/* ------------------------------------------------------------------ *
+ * Flavour text + mechanical text
+ *
+ * Every Jutsu, specialist technique and mastery passive must tell the player
+ * two separate things: what it IS (flavour) and what it DOES (mechanics).
+ * The authored `desc` field is used as the flavour line, and the mechanical
+ * line below is generated from the same structured numbers combat actually
+ * uses, so the two can never drift apart.
+ * ------------------------------------------------------------------ */
+
+const STAT_LABEL: Record<string, string> = {
+  nin: "Ninjutsu", gen: "Genjutsu", ken: "Kenjutsu", tac: "Tactics", doj: "Dōjutsu",
+  med: "Medical", spd: "Speed", ste: "Stealth", atk: "Attack",
+};
+
+const TARGET_LABEL: Record<JutsuTarget, string> = {
+  foe: "one enemy",
+  all_foes: "every enemy",
+  ally: "one ally",
+  all_allies: "the whole squad",
+  self: "the caster",
+};
+
+const EFFECT_TEXT: Record<JutsuEffect, (j: JutsuDef) => string | null> = {
+  burn: (j) => `applies Burn for ${j.effectValue ?? 2} round${(j.effectValue ?? 2) === 1 ? "" : "s"}`,
+  poison: (j) => `applies Poison for ${j.effectValue ?? 2} rounds`,
+  bleed: (j) => `applies Bleed for ${j.effectValue ?? 2} rounds`,
+  slow: (j) => `slows the target for ${Math.max(1, j.effectValue ?? 1)} round(s), cutting its initiative`,
+  guard: (j) => `grants a chakra barrier for ${j.effectValue ?? 2} rounds`,
+  brace: (j) => `grants a Guard stance for ${j.braceRounds ?? j.effectValue ?? 2} rounds`,
+  taunt: (j) => `forces enemies to prefer this target for ${j.tauntRounds ?? 2} rounds`,
+  retaliate: (j) => `returns ${Math.round((j.retaliationPct ?? 0.2) * 100)}% of damage taken for ${j.retaliationRounds ?? 2} rounds`,
+  shred: (j) => `reduces DEF by ${Math.round((j.shredPct ?? 0.1) * 100)}% for ${j.shredRounds ?? 2} rounds`,
+  stun: (j) => `attempts to stun for ${j.effectValue ?? 1} round(s)`,
+  pierce: (j) => `ignores ${j.effectValue ?? 0}% of the target's defence`,
+  crit: (j) => `adds +${j.effectValue ?? 10} percentage points critical chance`,
+  cleanse: () => "clears negative status effects",
+  regen: (j) => `applies regeneration for ${j.effectValue ?? 2} rounds`,
+  flow: () => "keeps the caster's chakra circulating",
+  tempo: () => "shifts the turn order in the caster's favour",
+  none: () => null,
+};
+
+function passiveMechanicParts(p: JutsuPassive): string[] {
+  const out: string[] = [];
+  const mult = (v: number) => `${v >= 1 ? "+" : ""}${Math.round((v - 1) * 100)}%`;
+  if (p.hp) out.push(`${mult(p.hp)} max HP`);
+  if (p.cp) out.push(`${mult(p.cp)} max chakra`);
+  if (p.atk) out.push(`${mult(p.atk)} battle ATK`);
+  if (p.def) out.push(`${mult(p.def)} battle DEF`);
+  if (p.spd) out.push(`${mult(p.spd)} battle speed`);
+  if (p.jutsuPower) out.push(`${mult(p.jutsuPower)} Jutsu damage`);
+  if (p.crit) out.push(`+${Math.round(p.crit * 100)}pp crit chance`);
+  if (p.dodge) out.push(`+${Math.round(p.dodge * 100)}pp dodge`);
+  if (p.counter) out.push(`+${Math.round(p.counter * 100)}% counter damage`);
+  if (p.burnAmp) out.push(`${mult(p.burnAmp)} Burn damage`);
+  if (p.burnRounds) out.push(`+${p.burnRounds} Burn round(s)`);
+  if (p.guardAmp) out.push(`${mult(p.guardAmp)} barrier absorption`);
+  if (p.braceAmp) out.push(`${mult(p.braceAmp)} Guard-stance strength`);
+  if (p.regenAmp) out.push(`${mult(p.regenAmp)} regeneration`);
+  if (p.pierceBonus) out.push(`+${Math.round(p.pierceBonus * 100)}pp armour pierce`);
+  if (p.stunBonus) out.push(`+${Math.round(p.stunBonus * 100)}pp stun chance`);
+  if (p.shredBonus) out.push(`+${Math.round(p.shredBonus * 100)}pp armour shred`);
+  if (p.tauntBonus) out.push(`+${Math.round(p.tauntBonus * 100)}pp taunt strength`);
+  if (p.retaliationBonus) out.push(`+${Math.round(p.retaliationBonus * 100)}pp retaliation`);
+  if (p.extraTurnBonus) out.push(`+${Math.round(p.extraTurnBonus * 100)}pp bonus-turn chance`);
+  if (p.chakraCost) out.push(`active Jutsu cost ${Math.round((1 - p.chakraCost) * 100)}% less chakra`);
+  return out;
+}
+
+/** What the technique looks and feels like in the fiction. */
+export function jutsuFlavour(j: JutsuDef): string {
+  if (j.desc && j.desc.trim().length > 0 && !/^PASSIVE:/i.test(j.desc)) return j.desc;
+  if (j.passive) {
+    return `${j.name} is not a technique that is thrown at an enemy: it is drilled until the body performs it without thought, permanently reshaping how this shinobi's ${j.pathLabel.toLowerCase()} work behaves.`;
+  }
+  return `${j.name} is a ${j.pathLabel.toLowerCase()} technique from the ${j.pathSummary.toLowerCase()} discipline, shaped by long repetition of the same hand seals.`;
+}
+
+/** Exactly what the technique does in combat, generated from its own numbers. */
+export function jutsuMechanics(j: JutsuDef): string {
+  if (j.passive) {
+    const parts = passiveMechanicParts(j.passive);
+    return `PASSIVE (no slot, no chakra): ${parts.length ? parts.join(", ") : "no numeric modifier"}.`;
+  }
+
+  const out: string[] = [];
+  const stat = j.stat ? STAT_LABEL[j.stat] ?? j.stat.toUpperCase() : "Ninjutsu";
+  const friendly = j.target === "ally" || j.target === "all_allies" || j.target === "self";
+
+  if (j.power > 0) {
+    const hits = j.hits ?? 1;
+    out.push(
+      friendly
+        ? `Heals ${TARGET_LABEL[j.target]} for ${j.power.toFixed(2)}× the caster's Ninjutsu/Medical scaling`
+        : `Deals ${j.power.toFixed(2)}× ${stat} damage${hits > 1 ? ` ×${hits} separate hits` : ""} to ${TARGET_LABEL[j.target]}`
+    );
+  } else {
+    out.push(`Targets ${TARGET_LABEL[j.target]} with no direct damage`);
+  }
+
+  const eff = EFFECT_TEXT[j.effect]?.(j);
+  if (eff) out.push(eff.charAt(0).toUpperCase() + eff.slice(1));
+
+  if (j.executeBelow) out.push(`Instantly finishes a target left below ${Math.round(j.executeBelow * 100)}% HP`);
+  if (j.recoilPct) out.push(`Costs the caster ${Math.round(j.recoilPct * 100)}% of their max HP`);
+  if (j.selfHealPct) out.push(`Heals the caster for ${Math.round(j.selfHealPct * 100)}% of damage dealt`);
+  if (j.allyHealPct) out.push(`Heals every ally for ${Math.round(j.allyHealPct * 100)}% of their max HP`);
+  if (j.cpDrainPct) out.push(`Drains ${Math.round(j.cpDrainPct * 100)}% of the target's chakra`);
+  if (j.cpRestorePct) out.push(`Restores ${Math.round(j.cpRestorePct * 100)}% of the caster's chakra`);
+  if (j.allyCpRestorePct) out.push(`Restores ${Math.round(j.allyCpRestorePct * 100)}% chakra to affected allies`);
+  if (j.speedBuffPct) out.push(`Grants +${Math.round(j.speedBuffPct * 100)}% speed for ${j.speedBuffRounds ?? 2} rounds`);
+  if (j.braceStrength && j.effect !== "brace") out.push(`Guard stance reduces damage by ${Math.round(j.braceStrength * 100)}% for ${j.braceRounds ?? 2} rounds`);
+  if (j.tauntStrength && j.effect !== "taunt") out.push(`Draws enemy attacks for ${j.tauntRounds ?? 2} rounds`);
+  if (j.extraTurnChance) out.push(`${Math.round(j.extraTurnChance * 100)}% chance of an immediate extra turn`);
+  if (j.ranged) out.push("Ranged: bypasses Guard stances and chakra barriers");
+
+  out.push(`Costs ${j.chakra} chakra · unlocks at Lv ${j.levelReq} · occupies 1 of 4 battle Jutsu slots`);
+  return `${out.join(". ")}.`;
+}
