+import type { JutsuDef } from "./jutsu";
+import type { Unit } from "./types";
+export type DamageOverTime = "burn" | "poison" | "bleed";
+export function isDamageOverTime(effect: string): effect is DamageOverTime { return effect === "burn" || effect === "poison" || effect === "bleed"; }
+export function statusTickDamage(effect: DamageOverTime, stat: number, power = 1, area = false, burnAmp = 1): number {
+  const coefficient = { burn: 0.55, poison: 0.45, bleed: 0.50 }[effect];
+  return Math.max(1, Math.round((5 + Math.max(0, stat) * coefficient) * Math.max(0, power) * (area ? 0.65 : 1) * (effect === "burn" ? burnAmp : 1)));
+}
+export function jutsuAttackStat(u: Unit, j: JutsuDef): number {
+  if (j.stat === "ste") return u.ste ?? u.nin;
+  return j.stat ? u[j.stat] : u.nin;
+}
+export function jutsuStatusPreview(u: Unit, j: JutsuDef): string | null {
+  if (!isDamageOverTime(j.effect) || j.passive) return null;
+  const damage = statusTickDamage(j.effect, jutsuAttackStat(u, j), u.jutsuPower, j.target === "all_foes", u.jutsuBurnAmp ?? 1);
+  const rounds = (j.effectValue ?? 2) + (j.effect === "burn" ? u.jutsuBurnRoundsBonus ?? 0 : 0);
+  return `${j.effect.toUpperCase()}: ${damage} HP/round for ${rounds} rounds. Ignores defence and guard; summon shields reduce ticks. Reapplication keeps the stronger tick and longer duration.`;
+}
