+/* ------------------------------------------------------------ summons */
+
+/**
+ * Summon interventions.
+ *
+ * Unlike Jutsu (spend chakra, spend your turn) and gear (a flat passive), a
+ * summon watches the fight and acts on its own exactly once. `summonUsed`
+ * gates that to a single firing per battle per ninja.
+ *
+ * Every trigger routes through here so the once-only rule, the log line and
+ * the effect resolution can never drift apart between call sites.
+ */
+function summonFor(u: Unit): SummonDef | null {
+  return u.summonId ? SUMMON_BY_ID[u.summonId] ?? null : null;
+}
+
+function partyOf(b: Battle, u: Unit): Unit[] {
+  return b.units.filter((x) => x.alive && x.foe === u.foe);
+}
+
+/**
+ * Fire `u`'s summon if it is present, unused, and matches `trigger`.
+ * Returns true when it actually fired.
+ */
+function fireSummon(b: Battle, u: Unit, trigger: SummonDef["trigger"]): boolean {
+  if (!u.alive && trigger !== "bonded_fatal") return false;
+  if (u.summonUsed) return false;
+  const sm = summonFor(u);
+  if (!sm || sm.trigger !== trigger) return false;
+  u.summonUsed = true;
+
+  log(b, `${u.name} summons ${sm.name} — ${sm.species}!`, "crit");
+
+  switch (sm.effect) {
+    case "shield": {
+      for (const ally of partyOf(b, u)) {
+        ally.summonShieldRounds = Math.max(ally.summonShieldRounds ?? 0, sm.rounds ?? 2);
+        ally.summonShieldPct = Math.max(ally.summonShieldPct ?? 0, sm.power);
+      }
+      log(b, `${sm.name} shields the squad — ${Math.round(sm.power * 100)}% less damage for ${sm.rounds} rounds.`, "heal");
+      break;
+    }
+    case "haste_party": {
+      for (const ally of partyOf(b, u)) {
+        ally.summonHasteRounds = Math.max(ally.summonHasteRounds ?? 0, sm.rounds ?? 2);
+        ally.summonHastePct = Math.max(ally.summonHastePct ?? 0, sm.power);
+      }
+      log(b, `${sm.name} calls the opening — the squad moves ${Math.round(sm.power * 100)}% faster.`, "heal");
+      break;
+    }
+    case "heal_bonded": {
+      const heal = Math.max(1, Math.round(u.maxHp * sm.power));
+      u.hp = Math.min(u.maxHp, u.hp + heal);
+      log(b, `${sm.name} closes ${u.name}'s wounds for ${heal} HP.`, "heal");
+      break;
+    }
+    case "restore_chakra": {
+      const gain = Math.max(1, Math.round(u.maxCp * sm.power));
+      u.cp = Math.min(u.maxCp, u.cp + gain);
+      log(b, `${sm.name} feeds ${gain} chakra back to ${u.name}.`, "heal");
+      break;
+    }
+    case "revive": {
