@@ -0,0 +1,391 @@
+import { useState } from "react";
+import type { GameState, Ninja } from "../game/types";
+import {
+  SUMMONS,
+  SUMMON_BY_ID,
+  SUMMON_PACKS,
+  SUMMON_RARITY_META,
+  bondSummon,
+  canChangeSummon,
+  ensureSummonState,
+  equippedSummon,
+  ownedSummonCount,
+  pullSummons,
+  releaseSummon,
+  summonAvailableCount,
+  summonBondedCount,
+  summonMechanics,
+  summonPullCost,
+  type SummonDef,
+} from "../game/summons";
+import { cn } from "../utils/cn";
+
+/** The cropped creature art, on a rarity-tinted plate. */
+export function SummonArt({ x, size = 64, dim }: { x: SummonDef; size?: number; dim?: boolean }) {
+  const meta = SUMMON_RARITY_META[x.rarity];
+  return (
+    <span
+      className="relative grid shrink-0 place-items-center overflow-hidden rounded-xl"
+      style={{
+        width: size,
+        height: size,
+        background: `radial-gradient(circle at 50% 62%, ${x.tint}30 0%, rgba(0,0,0,0.34) 70%)`,
+        boxShadow: `inset 0 0 0 1px ${meta.border}55`,
+      }}
+    >
+      <img
+        src={`/summons/${x.art}.png`}
+        alt=""
+        draggable={false}
+        decoding="async"
+        style={{
+          width: "104%",
+          height: "104%",
+          objectFit: "contain",
+          filter: dim ? "grayscale(1) brightness(0.6)" : `drop-shadow(0 1px 3px rgba(0,0,0,0.6))`,
+          opacity: dim ? 0.5 : 1,
+        }}
+      />
+    </span>
+  );
+}
+
+function RarityPill({ x }: { x: SummonDef }) {
+  const meta = SUMMON_RARITY_META[x.rarity];
+  return (
+    <span
+      className="shrink-0 rounded px-1.5 py-0.5 text-[8px] font-black tracking-wider"
+      style={{ color: meta.color, background: `${meta.color}18`, boxShadow: `inset 0 0 0 1px ${meta.color}40` }}
+    >
+      {meta.name.toUpperCase()}
+    </span>
+  );
+}
+
+/** Full pact card: art, bond, and the intervention spelled out. */
+function SummonCard({
+  x,
+  owned,
+  free,
+  bonded,
+  selected,
+  onSelect,
+}: {
+  x: SummonDef;
+  owned: number;
+  free: number;
+  bonded: number;
+  selected: boolean;
+  onSelect: () => void;
+}) {
+  const meta = SUMMON_RARITY_META[x.rarity];
+  return (
+    <button
+      type="button"
+      aria-label={`View ${owned > 0 ? x.name : x.species} pact`}
+      aria-pressed={selected}
+      onClick={onSelect}
+      className={cn(
+        "w-full rounded-xl p-2 text-left ring-1 ring-inset transition",
+        selected ? "bg-gold/[0.07] ring-gold/50" : owned > 0 ? "bg-black/20 ring-white/8 hover:bg-white/[0.03]" : "bg-black/30 ring-white/5 opacity-55"
+      )}
+    >
+      <div className="flex items-start gap-2">
+        <SummonArt x={x} size={56} dim={owned === 0} />
+        <div className="min-w-0 flex-1">
+          <div className="flex items-center gap-1.5">
+            <p className="truncate text-[11px] font-black text-paper">{owned > 0 ? x.name : "???"}</p>
+            <RarityPill x={x} />
+          </div>
+          <p className="truncate text-[8.5px] font-bold tracking-wider text-paper/40">
+            {owned > 0 ? x.species.toUpperCase() : "PACT NOT YET FORMED"}
+          </p>
+          {owned > 0 && (
+            <p className="mt-1 text-[8.5px] font-black leading-tight" style={{ color: meta.color }}>
+              {x.bondText}
+            </p>
+          )}
+          <div className="mt-1 flex items-center gap-1.5 text-[8px] font-black tabular-nums">
+            {owned > 0 ? (
+              <>
+                <span className="text-paper/45">OWNED {owned}</span>
+                <span className={free > 0 ? "text-jade" : "text-paper/30"}>{free} FREE</span>
+                {bonded > 0 && <span className="text-gold">{bonded} BONDED</span>}
+              </>
+            ) : (
+              <span className="text-paper/30">UNDISCOVERED</span>
+            )}
+          </div>
+        </div>
+      </div>
+    </button>
+  );
+}
+
+/** Pick which ninja carries the selected pact. */
+function BondPanel({ s, x, onChanged }: { s: GameState; x: SummonDef; onChanged: () => void }) {
+  const free = summonAvailableCount(s, x.id);
+  const carriers = s.ninjas.filter((n) => n.summonId === x.id);
+  const candidates = s.ninjas.filter((n) => n.summonId !== x.id).sort((a, b) => b.level - a.level);
+
+  return (
+    <div className="mt-2 rounded-xl bg-black/25 p-2 ring-1 ring-white/6">
+      <div className="flex items-center justify-between">
+        <p className="text-[8px] font-black tracking-[0.16em] text-paper/45">BONDED TO</p>
+        <span className={cn("rounded px-1.5 py-0.5 text-[8px] font-black", free > 0 ? "bg-jade/15 text-jade" : "bg-black/30 text-paper/35")}>
+          {free} AVAILABLE
+        </span>
+      </div>
+
+      {carriers.length > 0 && (
+        <div className="mt-1.5 space-y-1">
+          {carriers.map((n) => (
+            <div key={n.id} className="flex items-center gap-2 rounded-lg bg-gold/[0.07] p-1.5 ring-1 ring-gold/25">
+              <span className="min-w-0 flex-1 truncate text-[10px] font-black text-paper">{n.name}</span>
+              <span className="text-[8px] font-bold text-paper/40">Lv {n.level}</span>
+              <button
+                type="button"
+                disabled={!canChangeSummon(s, n)} onClick={() => { releaseSummon(s, n); onChanged(); }}
+                className="rounded-md bg-black/35 px-2 py-1 text-[8px] font-black text-vermil ring-1 ring-vermil/20"
+              >
+                RELEASE
+              </button>
+            </div>
+          ))}
+        </div>
+      )}
+
+      <p className="mt-2 text-[8px] font-black tracking-[0.16em] text-paper/35">BOND TO A SHINOBI</p>
+      <div className="mt-1 max-h-40 space-y-1 overflow-y-auto pr-1">
+        {candidates.map((n) => {
+          const current = equippedSummon(n);
+          const blocked = free <= 0 || !canChangeSummon(s, n);
+          return (
+            <button
+              key={n.id}
+              type="button"
+              aria-label={`Bond ${x.name} to ${n.name}`}
+              disabled={blocked}
+              onClick={() => { if (bondSummon(s, n, x.id)) onChanged(); }}
+              className={cn(
+                "flex w-full items-center gap-2 rounded-lg p-1.5 text-left ring-1 transition",
+                blocked ? "bg-black/20 ring-white/5 opacity-40" : "bg-black/25 ring-white/7 hover:bg-white/[0.04]"
+              )}
+            >
+              <span className="min-w-0 flex-1 truncate text-[10px] font-bold text-paper/85">{n.name}</span>
+              <span className="shrink-0 text-[8px] font-bold text-paper/35">Lv {n.level}</span>
+              {current && (
+                <span className="shrink-0 rounded bg-black/40 px-1 py-0.5 text-[7.5px] font-black text-paper/45" title={`Currently carries ${current.name}`}>
+                  SWAPS {current.name}
+                </span>
+              )}
+            </button>
+          );
+        })}
+        {!candidates.length && <p className="p-2 text-[8.5px] text-paper/30">Every shinobi already carries this pact.</p>}
+      </div>
+    </div>
+  );
+}
+
+export default function SummonScreen({ s, onChanged }: { s: GameState; onChanged: () => void }) {
+  const st = ensureSummonState(s);
+  const [selected, setSelected] = useState<string>(SUMMONS[0].id);
+  const [reveal, setReveal] = useState<SummonDef[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const x = SUMMON_BY_ID[selected] ?? SUMMONS[0];
+  const owned = st.inventory[x.id] ?? 0;
+
+  const draw = (pulls: 1 | 5) => {
+    const r = pullSummons(s, pulls);
+    if (!r.ok) { setError(r.error ?? "Unable to draw."); return; }
+    setError(null);
+    setReveal(r.items);
+    onChanged();
+  };
