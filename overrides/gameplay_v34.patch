+
+export const SUMMON_BY_ID: Record<string, SummonDef> = Object.fromEntries(SUMMONS.map((x) => [x.id, x]));
+
+const _ids = SUMMONS.map((x) => x.id);
+if (new Set(_ids).size !== _ids.length) throw new Error("Duplicate summon id detected");
+
+export const SUMMON_TRIGGER_TEXT: Record<SummonTrigger, string> = {
+  battle_start: "at the start of the battle",
+  bonded_low_hp: "the first time the bonded ninja drops below 35% HP",
+  bonded_fatal: "the first time a blow would kill the bonded ninja",
+  ally_fallen: "the first time any ally is knocked out",
+  chakra_empty: "the first time the bonded ninja falls below 25% chakra",
+  round_three: "at the start of round 3",
+};
+
+/** Plain-language mechanics, generated from the same numbers combat uses. */
+export function summonMechanics(x: SummonDef): string {
+  const t = SUMMON_TRIGGER_TEXT[x.trigger];
+  const r = x.rounds ?? 0;
+  let effect: string;
+  switch (x.effect) {
+    case "shield":
+      effect = `the whole squad takes ${Math.round(x.power * 100)}% less damage for ${r} rounds`;
+      break;
+    case "heal_bonded":
+      effect = `the bonded ninja recovers ${Math.round(x.power * 100)}% of their max HP`;
+      break;
+    case "revive":
+      effect = `the killing blow is cancelled and the ninja survives at ${Math.round(x.power * 100)}% HP`;
+      break;
+    case "restore_chakra":
+      effect = `the bonded ninja recovers ${Math.round(x.power * 100)}% of their max chakra`;
+      break;
+    case "strike_all":
+      effect = `the summon attacks every enemy for ${x.power.toFixed(2)}× power`;
+      break;
+    case "strike_one":
+      effect = `the summon attacks the strongest enemy for ${x.power.toFixed(2)}× power`;
+      break;
+    case "cleanse_party":
+      effect = "every debuff and illusion on your side is cleared";
+      break;
+    case "haste_party":
+      effect = `the squad gains +${Math.round(x.power * 100)}% SPD for ${r} rounds`;
+      break;
+  }
+  return `INTERVENTION — once per battle, ${t}, ${effect}. This costs no chakra and does not use the ninja's turn. BOND — ${x.bondText}, active whenever the summon is equipped.`;
+}
+
+/* ---------------------------------------------------------------- state */
+
+export interface SummonState {
+  /** Owned summon ids and how many copies of each. */
+  inventory: Record<string, number>;
+  recent: string[];
+  totalPulls: number;
+  /** Pity counter: pulls since the last epic or better. */
+  sinceEpic: number;
+}
+
+type SummonCarrier = { summonId?: string | null };
+type SummonGameState = GameState & { summons?: SummonState };
+
+export function ensureSummonState(s: GameState): SummonState {
+  const st = s as SummonGameState;
+  if (!st.summons) st.summons = { inventory: {}, recent: [], totalPulls: 0, sinceEpic: 0 };
+  if (!st.summons.inventory || typeof st.summons.inventory !== "object") st.summons.inventory = {};
+  if (!Array.isArray(st.summons.recent)) st.summons.recent = [];
+  if (typeof st.summons.totalPulls !== "number") st.summons.totalPulls = 0;
+  if (typeof st.summons.sinceEpic !== "number") st.summons.sinceEpic = 0;
+  return st.summons;
+}
+
+/** The summon bonded to this ninja, if any. */
+export function equippedSummon(n: Ninja): SummonDef | null {
+  const id = (n as Ninja & SummonCarrier).summonId;
+  return id ? SUMMON_BY_ID[id] ?? null : null;
+}
+
+export function summonBondedCount(s: GameState, summonId: string): number {
+  return s.ninjas.reduce((sum, n) => sum + ((n as Ninja & SummonCarrier).summonId === summonId ? 1 : 0), 0);
+}
+
+export function summonAvailableCount(s: GameState, summonId: string): number {
+  const owned = ensureSummonState(s).inventory[summonId] ?? 0;
+  return Math.max(0, owned - summonBondedCount(s, summonId));
+}
+
+/**
+ * A summon can serve one ninja at a time. Unlike equipment, which is
+ * deliberately unrestricted, a pact is exclusive — that exclusivity is what
+ * makes choosing who carries the Spirit Fox an actual decision.
+ */
+export function bondSummon(s: GameState, n: Ninja, summonId: string): boolean {
+  if (!canChangeSummon(s, n)) return false;
+  if (!SUMMON_BY_ID[summonId]) return false;
+  const carrier = n as Ninja & SummonCarrier;
+  if (carrier.summonId === summonId) return true;
+  if (summonAvailableCount(s, summonId) <= 0) return false;
+  carrier.summonId = summonId;
+  return true;
+}
+
+export function canChangeSummon(s: GameState, n: Ninja): boolean {
+  return s.ninjas.includes(n) && ["playing", "paused"].includes(s.phase) && n.status === "ready";
+}
+export function releaseSummon(s: GameState, n: Ninja): boolean {
+  if (!canChangeSummon(s, n)) return false;
+  (n as Ninja & SummonCarrier).summonId = null;
+  return true;
+}
+
+/* ---------------------------------------------------------------- gacha */
+
+export const SUMMON_PULL_GOLD = 260;
+export const SUMMON_PULL_RICE = 130;
+export const SUMMON_PACKS = [
+  { pulls: 1 as const, discount: 0, label: "1 PACT" },
+  { pulls: 5 as const, discount: 0.10, label: "5 PACTS" },
+] as const;
+
+/**
+ * Summon pacts are a separate draw from the equipment supply line, with their
+ * own currency cost, their own pity timer and no shared inventory.
+ */
+export function summonPullCost(pulls: 1 | 5, s?: Pick<GameState, "b" | "techs">): { gold: number; rice: number; discount: number } {
+  const pack = SUMMON_PACKS.find((x) => x.pulls === pulls)!;
+  // The Shrine is the spiritual building, so it — not the Forge — discounts pacts.
+  const shrine = s ? Math.min(0.18, (s.b.shrine ?? 0) * 0.06) : 0;
+  const mult = (1 - pack.discount) * (1 - shrine);
+  return {
+    gold: Math.round(SUMMON_PULL_GOLD * pulls * mult),
+    rice: Math.round(SUMMON_PULL_RICE * pulls * mult),
+    discount: 1 - mult,
+  };
+}
+
+function rollSummonRarity(pity: number): SummonRarity {
+  // Hard pity at 12 draws without an epic or better, so a long unlucky run
+  // still terminates. The equipment gacha has no pity; this one does because
+  // there are only ten summons and duplicates are far more visible.
+  if (pity >= 11) return Math.random() < 0.25 ? "legendary" : "epic";
+  let r = Math.random() * 100;
+  for (const rarity of ["legendary", "epic", "rare", "common"] as SummonRarity[]) {
+    const w = SUMMON_RARITY_META[rarity].weight;
+    if (r < w) return rarity;
+    r -= w;
+  }
+  return "common";
+}
+
+export function pullSummons(s: GameState, pulls: 1 | 5): { ok: boolean; error?: string; items: SummonDef[]; newIds: string[] } {
+  if (![1, 5].includes(pulls) || s.phase !== "playing") return { ok: false, error: "Resume village play before drawing pacts.", items: [], newIds: [] };
+  const cost = summonPullCost(pulls, s);
+  if (s.ap < 1) return { ok: false, error: "No actions remaining today.", items: [], newIds: [] };
+  if (s.gold < cost.gold) return { ok: false, error: `Need ${cost.gold.toLocaleString()} gold.`, items: [], newIds: [] };
+  if (s.rice < cost.rice) return { ok: false, error: `Need ${cost.rice.toLocaleString()} rice.`, items: [], newIds: [] };
+
+  const st = ensureSummonState(s);
+  s.ap -= 1;
+  s.gold -= cost.gold;
+  s.rice -= cost.rice;
+
+  const items: SummonDef[] = [];
+  const newIds: string[] = [];
+  for (let i = 0; i < pulls; i++) {
+    const rarity = rollSummonRarity(st.sinceEpic);
+    const pool = SUMMONS.filter((x) => x.rarity === rarity);
+    const pick = pool[Math.floor(Math.random() * pool.length)];
+    if (rarity === "epic" || rarity === "legendary") st.sinceEpic = 0;
+    else st.sinceEpic += 1;
+    if (!st.inventory[pick.id]) newIds.push(pick.id);
+    st.inventory[pick.id] = (st.inventory[pick.id] ?? 0) + 1;
+    items.push(pick);
+  }
+  st.totalPulls += pulls;
+  st.recent = [...items.map((x) => x.id).reverse(), ...st.recent].slice(0, 60);
+  return { ok: true, items, newIds };
+}
+
+export function ownedSummonCount(s: GameState): number {
+  const inv = ensureSummonState(s).inventory;
+  return Object.keys(inv).filter((id) => (inv[id] ?? 0) > 0).length;
+}
