+import type { GameState } from "./types";
+import { NINJA_NAMES, SURNAMES } from "./content";
+export function clanRecruitChance(s: Pick<GameState, "techs">, pot: number): number {
+  return [0.10, 0.16, 0.22, 0.28, 0.34][Math.max(0, Math.min(4, pot - 1))] + (s.techs.includes("hall_elite_recruitment") ? 0.04 : 0);
+}
+export function kekkeiRecruitChance(s: Pick<GameState, "techs">, pot: number): number {
+  return (pot >= 4 ? 0.12 : 0.08) + (s.techs.includes("hall_elite_recruitment") ? 0.02 : 0);
+}
+/** Per three candidates. Elapsed days never inflate legendary recruitment. */
+export function legendScoutChance(s: Pick<GameState, "techs" | "b">): number {
+  return Math.min(0.06, 0.02 + Math.min(2, Math.max(0, s.b.hall - 1)) * 0.005 + (s.techs.includes("hall_elite_recruitment") ? 0.02 : 0) + (s.techs.includes("tea_black_market") ? 0.01 : 0));
+}
+export function recruitName(existing: readonly string[], random = Math.random): string {
+  const used = new Set(existing), firsts = new Set(existing.map(n => n.split(" ")[0]));
+  const fresh = NINJA_NAMES.filter(n => !firsts.has(n)), pool = fresh.length ? fresh : NINJA_NAMES;
+  const first = pool[Math.floor(random() * pool.length)], start = Math.floor(random() * SURNAMES.length);
+  for (let i = 0; i < SURNAMES.length; i++) {
+    const name = `${first} ${SURNAMES[(start + i) % SURNAMES.length]}`;
+    if (!used.has(name)) return name;
+  }
+  for (const given of NINJA_NAMES) for (const surname of SURNAMES) {
+    const name = `${given} ${surname}`; if (!used.has(name)) return name;
+  }
+  let suffix = 2; while (used.has(`${first} ${SURNAMES[start]} ${suffix}`)) suffix++;
+  return `${first} ${SURNAMES[start]} ${suffix}`;
+}
