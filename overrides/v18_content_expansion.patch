+
+/* ---------- summon pact reveal ---------- */
+
+.summon-reveal {
+  animation: summonReveal 0.5s cubic-bezier(0.18, 1.3, 0.4, 1) both;
+}
+
+@keyframes summonReveal {
+  0% { transform: scale(0.6) translateY(10px); opacity: 0; filter: brightness(2.2); }
+  55% { transform: scale(1.06) translateY(0); opacity: 1; filter: brightness(1.3); }
+  100% { transform: scale(1); opacity: 1; filter: brightness(1); }
+}
+
+/* ---------- bingo book ---------- */
+
+/*
+ * The Bingo Book is the endgame screen, but it was styled like every other
+ * panel: flat dark cards on a flat dark background. These give it the feel of
+ * a physical hunter's ledger — aged paper, stamped verdicts, redacted files.
+ */
+
+.bingo-paper {
+  background:
+    radial-gradient(circle at 18% 12%, rgba(226, 69, 47, 0.05) 0%, transparent 42%),
+    radial-gradient(circle at 84% 78%, rgba(114, 183, 239, 0.045) 0%, transparent 46%),
+    linear-gradient(155deg, #14121b 0%, #0f111c 55%, #120f16 100%);
+}
+
+/* Faint horizontal ruling, like a case file page. */
+.bingo-ruled {
+  background-image: repeating-linear-gradient(
+    to bottom,
+    transparent 0px,
+    transparent 21px,
+    rgba(239, 230, 208, 0.028) 21px,
+    rgba(239, 230, 208, 0.028) 22px
+  );
+}
+
+.bingo-card {
+  position: relative;
+  transition: transform 0.16s ease, box-shadow 0.16s ease;
+}
+
+.bingo-card:hover {
+  transform: translateY(-1px);
+}
+
+.bingo-card.is-selected {
+  box-shadow: -2px 0 0 0 var(--tc, #f4c64f) inset;
+}
+
+/* Threat-tier left edge on every dossier. */
+.bingo-card::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  top: 8%;
+  bottom: 8%;
+  width: 2px;
+  border-radius: 2px;
+  background: var(--tc, #6b7280);
+  opacity: 0.5;
+}
+
+/* Rotated ink stamp used for KILLED / CAPTURED / RECRUITED verdicts. */
+.bingo-stamp {
+  transform: rotate(-11deg);
+  border: 2px solid currentColor;
+  border-radius: 5px;
+  letter-spacing: 0.22em;
+  opacity: 0.85;
+  animation: stampIn 0.34s cubic-bezier(0.2, 1.7, 0.4, 1) both;
+}
+
+@keyframes stampIn {
+  0% { transform: rotate(-11deg) scale(2.1); opacity: 0; }
+  60% { transform: rotate(-11deg) scale(0.94); opacity: 0.95; }
+  100% { transform: rotate(-11deg) scale(1); opacity: 0.85; }
+}
+
+/* Intel bar fill: animated sweep so gathering intel feels like progress. */
+.intel-fill {
+  position: relative;
+  overflow: hidden;
+  transition: width 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
+}
+
+.intel-fill::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
+  background-size: 220% 100%;
+  animation: shimmer 2.6s linear infinite;
+}
+
+/* Unidentified targets: the portrait plate breathes and stays obscured. */
+.bingo-redacted {
+  animation: redactPulse 3.4s ease-in-out infinite;
+}
+
+@keyframes redactPulse {
+  0%, 100% { opacity: 0.32; }
+  50% { opacity: 0.6; }
+}
+
+/* Active hunt banner: slow danger pulse along the top edge. */
+.hunt-live {
+  position: relative;
+  overflow: hidden;
+}
+
+.hunt-live::before {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 0;
+  height: 1.5px;
+  background: linear-gradient(90deg, transparent, #e2452f, transparent);
+  background-size: 55% 100%;
+  animation: huntSweep 2.8s linear infinite;
+}
+
+@keyframes huntSweep {
+  from { background-position: -60% 0; }
+  to { background-position: 160% 0; }
+}
+
+/* Stage pips along the hunt track. */
+.stage-pip {
+  transition: background-color 0.3s ease, transform 0.3s ease;
+}
+
+.stage-pip.done { transform: scale(1); }
+.stage-pip.current {
+  transform: scale(1.35);
+  animation: pulseSoft 1.5s ease-in-out infinite;
+}
