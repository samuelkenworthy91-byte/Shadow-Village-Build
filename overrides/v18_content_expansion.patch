@@ -0,0 +1,351 @@
+import type { GameState, Ninja } from "./types";
+
+/**
+ * Animal summons — a third progression axis alongside gear and Jutsu.
+ *
+ * The design problem: a summon that just adds stats is a second equipment
+ * slot, and a summon you spend chakra to activate is a second Jutsu. Summons
+ * instead run on **interventions**: a once-per-battle effect that fires
+ * automatically the moment its trigger condition is met, without consuming the
+ * ninja's turn or any chakra.
+ *
+ * That makes them the only system in the game that acts on your behalf. You
+ * choose a summon for the situation it rescues you from rather than for a
+ * number it adds, and two ninjas with identical gear and Jutsu can still play
+ * very differently depending on the pact they carry.
+ *
+ * Each summon also carries a small always-on bond, so an unspent intervention
+ * is never a wasted slot.
+ */
+
+export type SummonRarity = "common" | "rare" | "epic" | "legendary";
+
+/** When the once-per-battle intervention fires. */
+export type SummonTrigger =
+  | "battle_start"      // immediately, before the first turn
+  | "bonded_low_hp"     // the bonded ninja drops below 35% HP
+  | "bonded_fatal"      // a blow would kill the bonded ninja
+  | "ally_fallen"       // any ally is knocked out
+  | "chakra_empty"      // the bonded ninja is below 15% chakra
+  | "round_three";      // start of round 3
+
+/** What the intervention does when it fires. */
+export type SummonEffect =
+  | "shield"            // grant temporary damage reduction to the whole party
+  | "heal_bonded"       // restore HP to the bonded ninja
+  | "revive"            // cancel the fatal blow and leave them at low HP
+  | "restore_chakra"    // refill part of the bonded ninja's chakra
+  | "strike_all"        // the summon attacks every enemy
+  | "strike_one"        // the summon attacks the strongest enemy
+  | "cleanse_party"     // clear all debuffs and illusions from your side
+  | "haste_party";      // party-wide speed and extra-turn surge
+
+export interface SummonDef {
+  id: string;
+  name: string;
+  species: string;
+  /** Filename stem under /summons. */
+  art: string;
+  kanji: string;
+  rarity: SummonRarity;
+  /** Accent colour used by the portrait badge and cards. */
+  tint: string;
+  trigger: SummonTrigger;
+  effect: SummonEffect;
+  /** Effect magnitude; meaning depends on `effect`. */
+  power: number;
+  /** Rounds the effect persists, where that applies. */
+  rounds?: number;
+  /** Always-on bond, applied while the summon is equipped. */
+  bond: {
+    atk?: number;
+    def?: number;
