+                )}
+              >
+                <SummonArt x={x} size={34} dim={free <= 0 && !isMine} />
+                <span className="min-w-0 flex-1">
+                  <span className="block truncate text-[9.5px] font-black text-paper/90">{x.name}</span>
+                  <span className="block truncate text-[8px] font-bold" style={{ color: x.tint }}>{x.bondText}</span>
+                </span>
+                <span className="shrink-0 text-[8px] font-black text-paper/35">{isMine ? "BONDED" : free > 0 ? `${free} FREE` : "IN USE"}</span>
+              </button>
+            );
+          })}
+        </div>
+      )}
+    </div>
+  );
+}
