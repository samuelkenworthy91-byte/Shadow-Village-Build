diff -ruN '--exclude=node_modules' '--exclude=dist' '--exclude=*.orig' '--exclude=*.rej' '--exclude=vite.config.ts' '--exclude=summons' a/src/components/SummonScreen.tsx b/src/components/SummonScreen.tsx
--- a/src/components/SummonScreen.tsx	1970-01-01 00:00:00.000000000 +0000
+++ b/src/components/SummonScreen.tsx	2026-09-01 06:29:27.228966682 +0000
@@ -0,0 +1,386 @@
+import { useState } from "react";
+import type { GameState, Ninja } from "../game/types";
+import {
+  SUMMONS,
+  SUMMON_BY_ID,
+  SUMMON_PACKS,
+  SUMMON_RARITY_META,
+  bondSummon,
+  ensureSummonState,
+  equippedSummon,
+  ownedSummonCount,
+  pullSummons,
+  releaseSummon,
+  summonAvailableCount,
+  summonBondedCount,
+  summonMechanics,
+  summonPullCost,
+  type SummonDef,
+} from "../game/summons";
+import { cn } from "../utils/cn";
+
+/** The cropped creature art, on a rarity-tinted plate. */
+export function SummonArt({ x, size = 64, dim }: { x: SummonDef; size?: number; dim?: boolean }) {
+  const meta = SUMMON_RARITY_META[x.rarity];
+  return (
+    <span
+      className="relative grid shrink-0 place-items-center overflow-hidden rounded-xl"
+      style={{
+        width: size,
+        height: size,
+        background: `radial-gradient(circle at 50% 62%, ${x.tint}30 0%, rgba(0,0,0,0.34) 70%)`,
+        boxShadow: `inset 0 0 0 1px ${meta.border}55`,
+      }}
+    >
+      <img
+        src={`/summons/${x.art}.png`}
+        alt=""
+        draggable={false}
+        decoding="async"
+        style={{
+          width: "104%",
+          height: "104%",
+          objectFit: "contain",
+          filter: dim ? "grayscale(1) brightness(0.6)" : `drop-shadow(0 1px 3px rgba(0,0,0,0.6))`,
+          opacity: dim ? 0.5 : 1,
+        }}
+      />
+    </span>
+  );
+}
+
+function RarityPill({ x }: { x: SummonDef }) {
+  const meta = SUMMON_RARITY_META[x.rarity];
+  return (
+    <span
+      className="shrink-0 rounded px-1.5 py-0.5 text-[8px] font-black tracking-wider"
+      style={{ color: meta.color, background: `${meta.color}18`, boxShadow: `inset 0 0 0 1px ${meta.color}40` }}
+    >
+      {meta.name.toUpperCase()}
+    </span>
+  );
+}
+
+/** Full pact card: art, bond, and the intervention spelled out. */
+function SummonCard({
+  x,
+  owned,
+  free,
+  bonded,
+  selected,
+  onSelect,
+}: {
+  x: SummonDef;
+  owned: number;
+  free: number;
+  bonded: number;
+  selected: boolean;
+  onSelect: () => void;
+}) {
+  const meta = SUMMON_RARITY_META[x.rarity];
+  return (
+    <button
+      type="button"
+      onClick={onSelect}
+      className={cn(
+        "w-full rounded-xl p-2 text-left ring-1 ring-inset transition",
+        selected ? "bg-gold/[0.07] ring-gold/50" : owned > 0 ? "bg-black/20 ring-white/8 hover:bg-white/[0.03]" : "bg-black/30 ring-white/5 opacity-55"
+      )}
+    >
+      <div className="flex items-start gap-2">
+        <SummonArt x={x} size={56} dim={owned === 0} />
+        <div className="min-w-0 flex-1">
+          <div className="flex items-center gap-1.5">
+            <p className="truncate text-[11px] font-black text-paper">{owned > 0 ? x.name : "???"}</p>
+            <RarityPill x={x} />
+          </div>
+          <p className="truncate text-[8.5px] font-bold tracking-wider text-paper/40">
+            {owned > 0 ? x.species.toUpperCase() : "PACT NOT YET FORMED"}
+          </p>
+          {owned > 0 && (
+            <p className="mt-1 text-[8.5px] font-black leading-tight" style={{ color: meta.color }}>
+              {x.bondText}
+            </p>
+          )}
+          <div className="mt-1 flex items-center gap-1.5 text-[8px] font-black tabular-nums">
+            {owned > 0 ? (
+              <>
+                <span className="text-paper/45">OWNED {owned}</span>
+                <span className={free > 0 ? "text-jade" : "text-paper/30"}>{free} FREE</span>
+                {bonded > 0 && <span className="text-gold">{bonded} BONDED</span>}
+              </>
+            ) : (
+              <span className="text-paper/30">UNDISCOVERED</span>
+            )}
+          </div>
+        </div>
+      </div>
+    </button>
+  );
+}
+
+/** Pick which ninja carries the selected pact. */
+function BondPanel({ s, x, onChanged }: { s: GameState; x: SummonDef; onChanged: () => void }) {
+  const free = summonAvailableCount(s, x.id);
+  const carriers = s.ninjas.filter((n) => n.summonId === x.id);
+  const candidates = s.ninjas.filter((n) => n.summonId !== x.id).sort((a, b) => b.level - a.level);
+
+  return (
+    <div className="mt-2 rounded-xl bg-black/25 p-2 ring-1 ring-white/6">
+      <div className="flex items-center justify-between">
+        <p className="text-[8px] font-black tracking-[0.16em] text-paper/45">BONDED TO</p>
+        <span className={cn("rounded px-1.5 py-0.5 text-[8px] font-black", free > 0 ? "bg-jade/15 text-jade" : "bg-black/30 text-paper/35")}>
+          {free} AVAILABLE
+        </span>
+      </div>
+
+      {carriers.length > 0 && (
+        <div className="mt-1.5 space-y-1">
+          {carriers.map((n) => (
+            <div key={n.id} className="flex items-center gap-2 rounded-lg bg-gold/[0.07] p-1.5 ring-1 ring-gold/25">
+              <span className="min-w-0 flex-1 truncate text-[10px] font-black text-paper">{n.name}</span>
+              <span className="text-[8px] font-bold text-paper/40">Lv {n.level}</span>
+              <button
+                type="button"
+                onClick={() => { releaseSummon(n); onChanged(); }}
+                className="rounded-md bg-black/35 px-2 py-1 text-[8px] font-black text-vermil ring-1 ring-vermil/20"
+              >
+                RELEASE
+              </button>
+            </div>
+          ))}
+        </div>
+      )}
+
+      <p className="mt-2 text-[8px] font-black tracking-[0.16em] text-paper/35">BOND TO A SHINOBI</p>
+      <div className="mt-1 max-h-40 space-y-1 overflow-y-auto pr-1">
+        {candidates.map((n) => {
+          const current = equippedSummon(n);
+          const blocked = free <= 0;
+          return (
+            <button
+              key={n.id}
+              type="button"
+              disabled={blocked}
+              onClick={() => { if (bondSummon(s, n, x.id)) onChanged(); }}
+              className={cn(
+                "flex w-full items-center gap-2 rounded-lg p-1.5 text-left ring-1 transition",
+                blocked ? "bg-black/20 ring-white/5 opacity-40" : "bg-black/25 ring-white/7 hover:bg-white/[0.04]"
+              )}
+            >
+              <span className="min-w-0 flex-1 truncate text-[10px] font-bold text-paper/85">{n.name}</span>
+              <span className="shrink-0 text-[8px] font-bold text-paper/35">Lv {n.level}</span>
+              {current && (
+                <span className="shrink-0 rounded bg-black/40 px-1 py-0.5 text-[7.5px] font-black text-paper/45" title={`Currently carries ${current.name}`}>
+                  SWAPS {current.kanji}
+                </span>
+              )}
+            </button>
+          );
+        })}
+        {!candidates.length && <p className="p-2 text-[8.5px] text-paper/30">Every shinobi already carries this pact.</p>}
+      </div>
+    </div>
+  );
+}
+
+export default function SummonScreen({ s, onChanged }: { s: GameState; onChanged: () => void }) {
+  const st = ensureSummonState(s);
+  const [selected, setSelected] = useState<string>(SUMMONS[0].id);
+  const [reveal, setReveal] = useState<SummonDef[] | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const x = SUMMON_BY_ID[selected] ?? SUMMONS[0];
+  const owned = st.inventory[x.id] ?? 0;
+
+  const draw = (pulls: 1 | 5) => {
+    const r = pullSummons(s, pulls);
+    if (!r.ok) { setError(r.error ?? "Unable to draw."); return; }
+    setError(null);
+    setReveal(r.items);
+    onChanged();
+  };
+
+  return (
+    <div className="flex h-full min-h-0 flex-col rounded-2xl bg-[#0f111c]/95 p-2 ring-1 ring-white/8">
+      {/* reveal overlay */}
+      {reveal && (
+        <div className="fixed inset-0 z-[160] grid place-items-center bg-black/85 p-4 backdrop-blur-sm" onClick={() => setReveal(null)}>
+          <div className="modal-pop w-full max-w-md rounded-2xl bg-[#151724] p-4 ring-1 ring-gold/30">
+            <p className="text-center text-[9px] font-black tracking-[0.2em] text-gold">PACT SEALED</p>
+            <div className={cn("mt-3 grid gap-2", reveal.length > 1 ? "grid-cols-3" : "grid-cols-1")}>
+              {reveal.map((item, i) => (
+                <div key={i} className="summon-reveal flex flex-col items-center rounded-xl bg-black/30 p-2 ring-1 ring-white/8" style={{ animationDelay: `${i * 90}ms` }}>
+                  <SummonArt x={item} size={reveal.length > 1 ? 62 : 130} />
+                  <p className="mt-1 text-center text-[9.5px] font-black text-paper">{item.name}</p>
+                  <p className="text-center text-[8px] font-bold" style={{ color: SUMMON_RARITY_META[item.rarity].color }}>
+                    {SUMMON_RARITY_META[item.rarity].name.toUpperCase()}
+                  </p>
+                </div>
+              ))}
+            </div>
+            <button type="button" onClick={() => setReveal(null)} className="mt-4 w-full rounded-xl bg-gold px-3 py-2.5 text-[10px] font-black tracking-wider text-[#241d12]">
+              CLOSE
+            </button>
+          </div>
+        </div>
+      )}
+
+      <div className="flex items-start justify-between gap-2 px-1 pb-2">
+        <div>
+          <p className="font-display text-[15px] font-black text-paper">SUMMONING PACTS</p>
+          <p className="text-[8px] font-bold tracking-[0.16em] text-paper/35">CONTRACT BEASTS · {ownedSummonCount(s)}/{SUMMONS.length} DISCOVERED</p>
+        </div>
+        <div className="text-right">
+          <p className="text-[8px] font-black text-gold">{st.totalPulls} PACTS DRAWN</p>
+          <p className="text-[7.5px] text-paper/30">Guaranteed Epic within {Math.max(0, 12 - st.sinceEpic)} draws</p>
+        </div>
+      </div>
+
+      {/* draw controls */}
+      <div className="mb-2 grid grid-cols-2 gap-2">
+        {SUMMON_PACKS.map((pack) => {
+          const cost = summonPullCost(pack.pulls, s);
+          const afford = s.gold >= cost.gold && s.rice >= cost.rice && s.ap >= 1;
+          return (
+            <button
+              key={pack.pulls}
+              type="button"
+              onClick={() => draw(pack.pulls)}
+              disabled={!afford}
+              className={cn(
+                "rounded-xl px-3 py-2 text-left ring-1 transition",
+                afford ? "bg-[#4a3b6e] ring-[#7a63ab] hover:brightness-110" : "bg-black/25 ring-white/7 opacity-45"
+              )}
+            >
+              <div className="flex items-center justify-between">
+                <span className="text-[10px] font-black tracking-wider text-paper">{pack.label}</span>
+                {cost.discount > 0 && <span className="text-[8px] font-black text-jade">−{Math.round(cost.discount * 100)}%</span>}
+              </div>
+              <p className="mt-0.5 text-[8.5px] font-bold tabular-nums text-paper/60">
+                {cost.gold.toLocaleString()} 両 · {cost.rice.toLocaleString()} rice · 1 AP
+              </p>
+            </button>
+          );
+        })}
+      </div>
+      {error && <p className="mb-2 rounded-lg bg-vermil/10 p-2 text-[9px] font-bold text-vermil ring-1 ring-vermil/20">{error}</p>}
+
+      <div className="grid min-h-0 flex-1 gap-2 lg:grid-cols-[320px_1fr]">
+        <div className="min-h-0 space-y-1.5 overflow-y-auto rounded-xl bg-black/15 p-2 ring-1 ring-white/5">
+          {SUMMONS.map((item) => (
+            <SummonCard
+              key={item.id}
+              x={item}
+              owned={st.inventory[item.id] ?? 0}
+              free={summonAvailableCount(s, item.id)}
+              bonded={summonBondedCount(s, item.id)}
+              selected={selected === item.id}
+              onSelect={() => setSelected(item.id)}
+            />
+          ))}
+        </div>
+
+        <div className="min-h-0 overflow-y-auto rounded-xl bg-black/15 p-3 ring-1 ring-white/5">
+          <div className="flex items-start gap-3">
+            <SummonArt x={x} size={104} dim={owned === 0} />
+            <div className="min-w-0 flex-1">
+              <div className="flex items-center gap-2">
+                <h3 className="font-display text-base font-black text-paper">{owned > 0 ? x.name : "UNDISCOVERED PACT"}</h3>
+                <RarityPill x={x} />
+              </div>
+              <p className="text-[9px] font-bold tracking-wider text-paper/40">{x.species.toUpperCase()}</p>
+              <p className="mt-1.5 text-[9px] leading-relaxed text-paper/50">{x.appearance}</p>
+            </div>
+          </div>
+
+          <p className="mt-3 text-[9.5px] italic leading-relaxed text-paper/55">{x.flavour}</p>
+
+          <p className="mt-3 text-[8px] font-black tracking-[0.18em] text-paper/40">MECHANICS</p>
+          <p className="mt-1 rounded-lg bg-black/30 p-2 text-[9px] leading-relaxed text-paper/70 ring-1 ring-white/6">
+            {summonMechanics(x)}
+          </p>
+
+          {owned > 0 ? (
+            <BondPanel s={s} x={x} onChanged={onChanged} />
+          ) : (
+            <p className="mt-2 rounded-lg bg-black/25 p-2 text-[8.5px] font-bold text-paper/35 ring-1 ring-white/5">
+              Draw pacts above to discover this contract beast.
+            </p>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+/** Compact bonded-summon strip used on the ninja detail screen. */
+export function NinjaSummonPanel({ s, n, onChanged }: { s: GameState; n: Ninja; onChanged: () => void }) {
+  const pact = equippedSummon(n);
+  const owned = SUMMONS.filter((x) => (ensureSummonState(s).inventory[x.id] ?? 0) > 0);
+  const [open, setOpen] = useState(false);
+
+  return (
+    <div className="border-b border-white/8 px-3 py-2">
+      <div className="flex items-center justify-between gap-2">
+        <p className="text-[9.5px] font-bold tracking-[0.2em] text-paper/40">SUMMONING PACT</p>
+        {owned.length > 0 && (
+          <button type="button" onClick={() => setOpen((v) => !v)} className="rounded-md bg-black/30 px-2 py-1 text-[8px] font-black text-paper/55 ring-1 ring-white/8">
+            {open ? "CLOSE" : pact ? "CHANGE" : "BOND"}
+          </button>
+        )}
+      </div>
+
+      {pact ? (
+        <div className="mt-1.5 flex items-start gap-2 rounded-xl bg-black/25 p-2 ring-1 ring-white/7">
+          <SummonArt x={pact} size={52} />
+          <div className="min-w-0 flex-1">
+            <div className="flex items-center gap-1.5">
+              <p className="truncate text-[10.5px] font-black text-paper">{pact.name}</p>
+              <RarityPill x={pact} />
+            </div>
+            <p className="text-[8px] font-black" style={{ color: pact.tint }}>{pact.bondText}</p>
+            <p className="mt-1 text-[8.5px] leading-snug text-paper/50">{summonMechanics(pact).split(" BOND —")[0]}</p>
+          </div>
+        </div>
+      ) : (
+        <p className="mt-1 text-[8.5px] text-paper/35">
+          {owned.length ? "No pact bonded. A summon acts once per battle without costing a turn." : "The village has not formed any summoning pacts yet."}
+        </p>
+      )}
+
+      {open && (
+        <div className="mt-1.5 max-h-44 space-y-1 overflow-y-auto rounded-xl bg-black/20 p-1.5 ring-1 ring-white/6">
+          {pact && (
+            <button type="button" onClick={() => { releaseSummon(n); onChanged(); setOpen(false); }} className="w-full rounded-lg bg-black/35 p-1.5 text-[8.5px] font-black text-vermil ring-1 ring-vermil/20">
+              RELEASE {pact.name.toUpperCase()}
+            </button>
+          )}
+          {owned.map((x) => {
+            const free = summonAvailableCount(s, x.id);
+            const isMine = pact?.id === x.id;
+            return (
+              <button
+                key={x.id}
+                type="button"
+                disabled={isMine || free <= 0}
+                onClick={() => { if (bondSummon(s, n, x.id)) { onChanged(); setOpen(false); } }}
+                className={cn(
+                  "flex w-full items-center gap-2 rounded-lg p-1.5 text-left ring-1 transition",
